<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Cad.Blueprint</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Avalonia-free CadBlueprint companion to CadDocument — contextual walls, interiors, exteriors, and openings (doors/hatches/holes) for ships, stations, houses, and towers; HTML5 smart-sheet export contract.</Description>
    <RootNamespace>Novolis.Cad.Blueprint</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Cad.Primitives\Novolis.Cad.Primitives.csproj" />
  </ItemGroup>
</Project>
