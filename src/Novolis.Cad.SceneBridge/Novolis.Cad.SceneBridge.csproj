<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Cad.SceneBridge</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Avalonia-free CadDocument → SceneDocument bridge: tessellate solids/walls/spaces into .nov3djson meshes (Novolis.Modeling.Scene).</Description>
    <RootNamespace>Novolis.Cad.SceneBridge</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.Modeling.Scene" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Cad.Primitives\Novolis.Cad.Primitives.csproj" />
  </ItemGroup>
</Project>
